<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Properties -->
    <PackageId>Specworks.iCalendar</PackageId>
    <Version>0.5.1</Version>
    <Authors>spec-works</Authors>
    <Company>spec-works</Company>
    <Product>Specworks.iCalendar</Product>
    <Description>A complete .NET library for parsing, validating, and serializing iCalendar (text/calendar) data according to RFC 5545. Includes a full Document Object Model (DOM) for all iCalendar components including VCALENDAR, VEVENT, VTODO, VJOURNAL, VALARM, VTIMEZONE, and more.</Description>
    <PackageTags>icalendar;calendar;parser;serializer;validator;rfc5545;vcalendar;vevent;vtodo;ics</PackageTags>
    <PackageProjectUrl>https://github.com/spec-works/iCalendar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spec-works/iCalendar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Updated namespace to Specworks.ICalendar for consistency with package naming.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2023-2026 spec-works</Copyright>

    <!-- Strong Naming -->
    <!-- The strong name key file is committed to the repository following Microsoft's guidance for open-source libraries.
         This allows contributors to build the same strong-named assembly and ensures a stable assembly identity.
         See: https://learn.microsoft.com/en-us/dotnet/standard/library-guidance/strong-naming -->
    <AssemblyName>Specworks.ICalendar</AssemblyName>
    <RootNamespace>Specworks.ICalendar</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ICalendar.snk</AssemblyOriginatorKeyFile>

    <!-- Source Link Support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
